---
import { siteBasePath } from "../../lib/siteBasePath.js";

const { iconUrl, title, fallbackColor, useImage = true } = Astro.props;

function withBasePath(path) {
  if (!path || !path.startsWith("/") || path.startsWith("//")) return path;
  return `${siteBasePath}${path}`;
}

function firstLetter(t) {
  const s = String(t ?? "").trim();
  if (!s) return "?";
  const ch = [...s][0];
  return ch.toLocaleUpperCase();
}

function contrastText(hex) {
  const h = String(hex ?? "").trim();
  if (!/^#[0-9A-Fa-f]{6}$/.test(h)) return "#ffffff";
  const r = Number.parseInt(h.slice(1, 3), 16) / 255;
  const g = Number.parseInt(h.slice(3, 5), 16) / 255;
  const b = Number.parseInt(h.slice(5, 7), 16) / 255;
  const luminance = 0.299 * r + 0.587 * g + 0.114 * b;
  return luminance > 0.55 ? "#1f2937" : "#ffffff";
}

const bg = /^#[0-9A-Fa-f]{6}$/.test(String(fallbackColor ?? "").trim())
  ? String(fallbackColor).trim()
  : "#6b7280";
const letter = firstLetter(title);
const color = contrastText(bg);
const src = withBasePath(iconUrl);
const showImage = useImage !== false && Boolean(iconUrl);
---

{
  showImage ? (
    <img
      class="h-11 w-11 shrink-0 rounded-xl object-cover"
      src={src}
      alt=""
      loading="lazy"
      data-fallback-bg={bg}
      data-fallback-color={color}
      data-fallback-letter={letter}
      onerror="this.replaceWith((() => { const d = document.createElement('div'); d.className = 'flex h-11 w-11 shrink-0 items-center justify-center rounded-full text-lg font-bold leading-none'; d.style.backgroundColor = this.dataset.fallbackBg; d.style.color = this.dataset.fallbackColor; d.setAttribute('aria-hidden', 'true'); d.textContent = this.dataset.fallbackLetter; return d; })())"
    />
  ) : (
    <div
      class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full text-lg font-bold leading-none"
      style={`background-color: ${bg}; color: ${color}`}
      aria-hidden="true"
    >
      {letter}
    </div>
  )
}
